# Copy this file to .env and fill in your key
GROQ_API_KEY=your_groq_api_key_here

# Model used for answer generation. Check https://console.groq.com/docs/models
# for the current list — Groq deprecates/renames models fairly often.
GROQ_MODEL=openai/gpt-oss-20b

# Local embedding model (downloaded once from HuggingFace on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where Chroma stores its vector DB on disk
CHROMA_PERSIST_DIR=./chroma_store
